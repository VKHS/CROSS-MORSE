{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cross-morse:stage-manifest:1.1",
  "title": "CROSS-MORSE executable-stage manifest",
  "description": "Shape validation only. scripts/validate_run_manifest.py additionally verifies actual files, original source/config/splits, tensor states, artifact ancestry and immutable parent hashes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "stage",
    "stage_index",
    "scientific_role",
    "dataset",
    "created_utc",
    "source_sha256",
    "config_sha256",
    "unit_sha256",
    "unit_manifest_path",
    "parent_manifest",
    "inputs",
    "outputs",
    "model_audit",
    "evaluator",
    "claim_scope"
  ],
  "properties": {
    "schema_version": {
      "const": "1.1"
    },
    "stage": {
      "enum": [
        "prepare",
        "train",
        "explore",
        "fit",
        "select",
        "confirm",
        "admit",
        "evaluate"
      ]
    },
    "stage_index": {
      "type": "integer",
      "minimum": 0,
      "maximum": 7
    },
    "scientific_role": {
      "enum": [
        "auxiliary",
        "D_fit",
        "D_explore",
        "D_select",
        "D_confirm",
        "D_admit",
        "D_test"
      ]
    },
    "dataset": {
      "enum": [
        "ogbn-arxiv",
        "ogbn-products",
        "ogbn-proteins",
        "Roman-empire",
        "PascalVOC-SP",
        "COCO-SP",
        "Peptides-func",
        "synthetic"
      ]
    },
    "created_utc": {
      "type": "string",
      "format": "date-time"
    },
    "source_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "config_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "unit_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "unit_manifest_path": {
      "const": "prepared/splits.npz"
    },
    "parent_manifest": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/artifact"
        }
      ]
    },
    "inputs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "model_audit": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/modelAudit"
        }
      ]
    },
    "evaluator": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/artifact"
        }
      ]
    },
    "claim_scope": {
      "type": "string",
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "stage": {
            "const": "prepare"
          }
        }
      },
      "then": {
        "properties": {
          "stage_index": {
            "const": 0
          },
          "scientific_role": {
            "const": "auxiliary"
          },
          "parent_manifest": {
            "type": "null"
          },
          "model_audit": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "stage": {
            "const": "train"
          }
        }
      },
      "then": {
        "properties": {
          "stage_index": {
            "const": 1
          },
          "scientific_role": {
            "const": "D_fit"
          },
          "model_audit": {
            "allOf": [
              {
                "$ref": "#/$defs/modelAudit"
              },
              {
                "properties": {
                  "scope": {
                    "const": "post_train_capture"
                  }
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "stage": {
            "const": "explore"
          }
        }
      },
      "then": {
        "properties": {
          "stage_index": {
            "const": 2
          },
          "scientific_role": {
            "const": "D_explore"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "stage": {
            "const": "fit"
          }
        }
      },
      "then": {
        "properties": {
          "stage_index": {
            "const": 3
          },
          "scientific_role": {
            "const": "D_explore"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "stage": {
            "const": "select"
          }
        }
      },
      "then": {
        "properties": {
          "stage_index": {
            "const": 4
          },
          "scientific_role": {
            "const": "D_select"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "stage": {
            "const": "confirm"
          }
        }
      },
      "then": {
        "properties": {
          "stage_index": {
            "const": 5
          },
          "scientific_role": {
            "const": "D_confirm"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "stage": {
            "const": "admit"
          }
        }
      },
      "then": {
        "properties": {
          "stage_index": {
            "const": 6
          },
          "scientific_role": {
            "const": "D_admit"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "stage": {
            "const": "evaluate"
          }
        }
      },
      "then": {
        "properties": {
          "stage_index": {
            "const": 7
          },
          "scientific_role": {
            "const": "D_test"
          },
          "evaluator": {
            "$ref": "#/$defs/artifact"
          },
          "outputs": {
            "minItems": 8,
            "maxItems": 8,
            "items": {
              "allOf": [
                {
                  "$ref": "#/$defs/artifact"
                },
                {
                  "properties": {
                    "path": {
                      "enum": [
                        "final/q0_probabilities.npy",
                        "final/qN_probabilities.npy",
                        "final/qC_probabilities.npy",
                        "final/qD_probabilities.npy",
                        "final/results_summary.json",
                        "final/paired_test_units.npz",
                        "final/results.csv",
                        "final/test_predictions.npz"
                      ]
                    }
                  }
                }
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "stage": {
            "not": {
              "const": "prepare"
            }
          }
        }
      },
      "then": {
        "properties": {
          "parent_manifest": {
            "$ref": "#/$defs/artifact"
          },
          "model_audit": {
            "$ref": "#/$defs/modelAudit"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "stage": {
            "not": {
              "enum": [
                "prepare",
                "train"
              ]
            }
          }
        }
      },
      "then": {
        "properties": {
          "model_audit": {
            "allOf": [
              {
                "$ref": "#/$defs/modelAudit"
              },
              {
                "properties": {
                  "scope": {
                    "const": "unchanged_since_train"
                  }
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "stage": {
            "not": {
              "const": "evaluate"
            }
          }
        }
      },
      "then": {
        "properties": {
          "evaluator": {
            "type": "null"
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "bytes"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "modelAudit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "baseline",
        "checkpoints",
        "matches_post_train_baseline"
      ],
      "properties": {
        "scope": {
          "enum": [
            "post_train_capture",
            "unchanged_since_train"
          ]
        },
        "baseline": {
          "$ref": "#/$defs/artifact"
        },
        "matches_post_train_baseline": {
          "const": true
        },
        "checkpoints": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "checkpoint_sha256",
              "backbone_sha256_before",
              "backbone_sha256_after",
              "head_sha256_before",
              "head_sha256_after"
            ],
            "properties": {
              "checkpoint_sha256": {
                "$ref": "#/$defs/sha256"
              },
              "backbone_sha256_before": {
                "$ref": "#/$defs/sha256"
              },
              "backbone_sha256_after": {
                "$ref": "#/$defs/sha256"
              },
              "head_sha256_before": {
                "$ref": "#/$defs/sha256"
              },
              "head_sha256_after": {
                "$ref": "#/$defs/sha256"
              }
            }
          }
        }
      }
    }
  }
}
