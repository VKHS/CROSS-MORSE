  "site_profile_policy": "configs/arrhenius-site.env.example ships the Arrhenius partition, architecture, module, environment and storage layout; the NAISS allocation and storage project identifiers are placeholders filled from the project's NAISS page before submitting jobs",
  "measurement_records_contract": {
    "specs": "records/specs.json",
