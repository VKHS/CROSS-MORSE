# CROSS-MORSE site profile for the NAISS Arrhenius cluster (NVIDIA GH200 nodes).
#
# This is the profile the authors' runs use. It is a complete Bash profile for
# run_cross_morse.sh (selected with CM_ENV_FILE) and documents every site-specific
# choice: architecture, partition, job shape, modules, interpreter and storage layout.
# Two identifiers are placeholders by design: the Slurm GPU allocation and the storage
# project. Fill them from the project's NAISS page, save the result as
# configs/arrhenius.env.example (git-ignored; auto-discovered by the launcher) or point
# CM_ENV_FILE at your copy. Exported CM_* values always override this file.
#
#   cp configs/arrhenius-site.env.example configs/arrhenius.env.example
#   $EDITOR configs/arrhenius.env.example      # set CM_ACCOUNT and CM_STORAGE_PROJECT
#   bash run_cross_morse_arxiv.sh dry-run full
#   bash run_cross_morse_arxiv.sh submit setup  # once per environment
#   bash run_cross_morse_arxiv.sh submit full
#
# docs/ARRHENIUS.md explains each step; docs/HPC.md the generic launcher contract.

# --- allocation (placeholders; see above) ----------------------------------------
# Slurm account of the GPU allocation, e.g. the NAISS project id with its -gpu suffix.
: "${CM_ACCOUNT:=}"
# NAISS storage project that owns the project disk used for CM_BASE.
: "${CM_STORAGE_PROJECT:=}"

# --- hardware and scheduler -------------------------------------------------------
# Arrhenius GH200 nodes are aarch64; the launcher refuses an x86_64 host with this set.
: "${CM_EXPECT_ARCH:=aarch64}"
# GPU partition; one task, one GPU, 16 CPU threads per job (sbatch header of run_cross_morse.sh).
: "${CM_PARTITION:=gpu}"
: "${CM_THREADS:=16}"
# Wall time per full-profile job; resume mode continues a suite whose stages were sealed.
: "${CM_TIME:=24:00:00}"

# --- storage layout ---------------------------------------------------------------
# All run suites, caches and logs live under CM_BASE on the project disk, never under
# $HOME. On Arrhenius the project disk is the no-backup project storage mounted on the
# login and compute nodes, /nobackup/proj/disk/<storage project>/; confirm the mount on
# your project page and with `dry-run` before the first submission.
if [[ -n "${CM_STORAGE_PROJECT}" ]]; then
    : "${CM_BASE:=/nobackup/proj/disk/${CM_STORAGE_PROJECT}/cross_morse}"
else
    # Without a storage project (laptop dry-runs) fall back to a home-directory workspace.
    : "${CM_BASE:=${HOME}/cross_morse_work}"
fi
# Raw dataset cache shared by every run (OGB, Roman-empire NPZ, LRGB) under CM_BASE.
: "${CM_DATA_ROOT:=${CM_BASE}/datasets/ogb_cache}"

# --- environment ------------------------------------------------------------------
# Modules are left empty on purpose: the persistent virtual environment below carries
# its own CUDA-enabled PyTorch wheel for aarch64 and the system compiler is sufficient.
: "${CM_BUILD_MODULE:=}"
: "${CM_PYTHON_MODULE:=}"
# Persistent interpreter created once by `submit setup`; code lives beside it under CM_BASE/code.
: "${CM_VENV_NAME:=venv_arrhenius_gh200}"
: "${CM_VENV_DIR:=${CM_BASE}/code/${CM_VENV_NAME}}"
# PyTorch wheel installed by `setup` only if the environment has none. Set the wheel
# specification and index for the CUDA build that matches the node driver (for example
# CM_TORCH_SPEC=torch and CM_TORCH_INDEX=https://download.pytorch.org/whl/cu128); the
# resolved versions are captured by environment/arrhenius/capture_environment.sh.
: "${CM_TORCH_SPEC:=}"
: "${CM_TORCH_INDEX:=}"

# --- experiment routing (dataset wrappers set CM_DATASET) ---------------------------
: "${CM_STAGE:=all}"
