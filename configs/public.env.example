# Generic GPU/Slurm profile. This file contains no project allocation or paths.
# Copy outside the source tree, edit for your cluster, and export CM_ENV_FILE.
# Alternatively export individual CM_* values; they override this file.
# CM_ACCOUNT must be set before using the submission wrapper.
: "${CM_ACCOUNT:=}"
: "${CM_STORAGE_PROJECT:=}"
: "${CM_BASE:=${HOME}/cross_morse_work}"
: "${CM_VENV_NAME:=venv_cross_morse}"
: "${CM_PARTITION:=gpu}"
: "${CM_THREADS:=16}"
# Shared launcher defaults to ogbn-arxiv; dataset-specific wrappers select theirs.
# CM_DATASET may name any canonical dataset. Leave CM_SPLIT_INDEX unset except
# for one Roman-empire split; the ten-split campaign chooses its indices itself.
# Set CM_DATA_ROOT to an existing shared raw-data cache when desired.
# Set CM_VENV_DIR to the absolute environment directory containing bin/python.
# Leaving those unset derives their paths from the effective CM_BASE at launch.
# Empty modules use the environment already active on the allocated GPU node.
: "${CM_BUILD_MODULE:=}"
: "${CM_PYTHON_MODULE:=}"
# Set aarch64 or x86_64 to enforce a cluster architecture, or leave empty.
: "${CM_EXPECT_ARCH:=}"
# Reuse an installed host-compatible PyTorch. To let setup install it, choose
# an explicit wheel specification and optional index appropriate to the host.
: "${CM_TORCH_SPEC:=}"
: "${CM_TORCH_INDEX:=}"
